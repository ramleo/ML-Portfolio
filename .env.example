# Backend URL — set this to wherever the ML-Unified backend is running.
# Local dev (no docker):  NEXT_PUBLIC_ML_UNIFIED_URL=http://localhost:8000
# HuggingFace Space:      NEXT_PUBLIC_ML_UNIFIED_URL=https://wram1708-ml-unified.hf.space
# Railway:                NEXT_PUBLIC_ML_UNIFIED_URL=https://your-service.railway.app
# Fly.io:                 NEXT_PUBLIC_ML_UNIFIED_URL=https://your-app.fly.dev
NEXT_PUBLIC_ML_UNIFIED_URL=https://wram1708-ml-unified.hf.space

# Real-Time Analytics Dashboard
NEXT_PUBLIC_ML_ANALYTICS_URL=https://wram1708-ml-analytics.hf.space
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Tool-card thumbnails. Only needed when adding a NEW tool:
#   python3 scripts/thumbnails.py add <tool-id> "search words" must,words
# Rebuilding the existing fifty needs no key:
#   python3 scripts/thumbnails.py rebuild
# Get a free key at https://www.pexels.com/api/ — keep it in .env.local, which git ignores.
PEXELS_API_KEY=
